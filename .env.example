# Copy to .env for local development. Values below are dev-only placeholders.
POSTGRES_DB=kervan
POSTGRES_USER=kervan
POSTGRES_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=kervan
RABBITMQ_DEFAULT_PASS=change-me

POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379

# Scaled stack (compose.scale.yaml)
KERVAN_JWT_SECRET=change-me-to-at-least-32-bytes-long-secret-value
ADMIN_EMAIL=admin@kervan.local
ADMIN_PASSWORD=change-me
